# Copy this file to .env and fill in real values. .env is gitignored.

# Credentials for the target portal (app/bot.py)
PORTAL_USERNAME=
PORTAL_PASSWORD=

# Webhook URL used for success and failure notifications.
# The demo uses Webhook.site as a mock endpoint.
# Leave empty to disable notifications.
SLACK_WEBHOOK_URL=

# Secret key used by Flask to sign session cookies (demo_portal/app.py)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
